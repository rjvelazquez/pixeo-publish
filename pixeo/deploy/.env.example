# Plantilla del .env de producción. Copiar a .env (chmod 600) y rellenar. Nunca subir el .env.
PP_IMAGE=ghcr.io/rjvelazquez/pixeo-publish:2.26.0-pixeo.5
PP_PROXY_NETWORK=chatbotx_main
PP_DB_PASSWORD=
PP_TEMPORAL_DB_PASSWORD=

MAIN_URL=https://publish.pixeocreativestudio.com
FRONTEND_URL=https://publish.pixeocreativestudio.com
NEXT_PUBLIC_BACKEND_URL=https://publish.pixeocreativestudio.com/api
JWT_SECRET=
# true después de crear la cuenta de administrador
DISABLE_REGISTRATION=false
API_LIMIT=30

# Correo (avisos de fallo): resend | nodemailer | ses
EMAIL_PROVIDER=
EMAIL_FROM_NAME=Pixeo Publish
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=

# Meta (app «Pixeo Publish»)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
